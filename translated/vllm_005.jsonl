{"id": "Verbals/VC_VerbalsNPC_Librarian|397730FA4E6DD36510BD1BA472E78493", "source_en": "A catalyst for a new age.", "category": "dialogue", "speaker": "NPC_Librarian", "ar": "محفزٌ لعصرٍ جديد.", "needs_review": false, "note": "", "provenance": {"stage": "primary", "model": "gemma4-12b-awq", "prompt": "cm-pilot-v1", "intent_localization_required": true, "batch": 5}}

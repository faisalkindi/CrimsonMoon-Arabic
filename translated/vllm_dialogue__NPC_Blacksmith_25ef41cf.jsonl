{"id": "Verbals/VC_VerbalsNPC_Blacksmith|BCD576144DC55C5A1ABE4DA3C1B15BB4", "source_en": "Return to Gajov when done.", "category": "dialogue", "speaker": "NPC_Blacksmith", "ar": "عُد لقاجوف عند الانتهاء.", "needs_review": false, "note": "", "provenance": {"stage": "primary", "model": "gemma4-12b-awq", "prompt": "cm-pilot-v1", "intent_localization_required": true, "batch": 6}}
{"id": "Verbals/VC_VerbalsNPC_Blacksmith|BCF1AABA42B78E516D730C8DA03D0154", "source_en": "Strong.", "category": "dialogue", "speaker": "NPC_Blacksmith", "ar": "قوي.", "needs_review": false, "note": "", "provenance": {"stage": "primary", "model": "gemma4-12b-awq", "prompt": "cm-pilot-v1", "intent_localization_required": true, "batch": 6}}
